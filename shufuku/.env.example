# 修復歴チェッカー 設定ファイル (このファイルを .env という名前でコピーして使います)

# AI判定に使う Claude の API キー (https://console.anthropic.com で取得)
# 空のままでも動きます(その場合は写真を見て自分で判定するモード)
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (標準) / claude-opus-5-5 (より高精度・料金は約2倍)
SHUFUKU_MODEL=claude-sonnet-5-5

# スマホから使うなら 0.0.0.0 のまま。パソコンだけなら 127.0.0.1
SHUFUKU_HOST=0.0.0.0
SHUFUKU_PORT=8100
# 他の人に見られたくない場合の合言葉(任意)。設定するとスマホで最初に入力を求められます
SHUFUKU_ACCESS_CODE=

# 新車塗装の膜厚の上限の目安(μm)。これを超えると「再塗装の疑い」
SHUFUKU_FILM_DOMESTIC=150
SHUFUKU_FILM_IMPORT=200
