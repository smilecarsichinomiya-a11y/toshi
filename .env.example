# --- Claude ---
ANTHROPIC_API_KEY=
TOSHI_MODEL=claude-sonnet-5-5

# --- 実行モード: paper(仮想売買・既定) / live(実売買) ---
TOSHI_MODE=paper
# live のときは下記も "yes" が必要 (誤発注防止)
TOSHI_LIVE_CONFIRM=no

# --- データ: yfinance / synthetic(オフライン検証用ダミー) ---
TOSHI_DATA=yfinance
# 監視銘柄(東証コード, カンマ区切り)
TOSHI_UNIVERSE=7203,6758,9984,8306,9432,6861,8035,4063,6098,7974

# --- 資金・リスク ---
TOSHI_INITIAL_CASH=3000000
# 売買単位(株)。東証の現物は100株
TOSHI_LOT_SIZE=100
TOSHI_MAX_POSITIONS=5
TOSHI_MAX_POSITION_PCT=0.30
TOSHI_CASH_RESERVE_PCT=0.10
TOSHI_STOP_LOSS_PCT=0.07
TOSHI_TRAILING_STOP_PCT=0.10
TOSHI_TAKE_PROFIT_PCT=0.20
TOSHI_DAILY_LOSS_LIMIT_PCT=0.03
TOSHI_MAX_ORDERS_PER_DAY=10

# --- スケジューラ ---
TOSHI_INTERVAL_MIN=60
TOSHI_AUTO_START=yes

# --- ダッシュボード ---
TOSHI_HOST=127.0.0.1
TOSHI_PORT=8000
# 設定すると API/操作に Bearer トークン必須 (外部公開する場合は必ず設定)
TOSHI_DASH_TOKEN=

# --- kabuステーション API (live時) ---
KABU_API_URL=http://localhost:18080/kabusapi
KABU_API_PASSWORD=
