# ============================================================
#  toshi 設定ファイル (このファイルを .env にコピーして使います)
#  証券口座は使いません。自動発注もしません(ペーパートレード)。
# ============================================================

# --- 動作モード: signals(毎晩の日足シグナルを通知) / daytrade(旧: 日中の仮想デイトレ) ---
TOSHI_MODE=signals
# 毎営業日、この時刻以降に日足でシグナルを判定します (日本時間)
TOSHI_SIGNAL_AT=18:00
# 資金は下の TOSHI_INITIAL_CASH。1銘柄の上限(総資産に対する割合)と同時保有の上限
TOSHI_SIGNAL_POS_PCT=0.25
TOSHI_SIGNAL_MAX_POSITIONS=4
# 楽天証券「かぶミニ®」の取扱銘柄だけを対象にする: yes / no (一覧は toshi/kabumini.json、2024-12-17時点)
TOSHI_MINI_ONLY=yes
# シグナルが無い日にも通知する: yes / no
TOSHI_NOTIFY_EMPTY=no

# --- 通知の設定 (メールか LINE のどちらか、または両方) ---
# メール: Gmail の場合は「アプリパスワード」を使います(README の「通知の設定」を参照)
TOSHI_SMTP_HOST=smtp.gmail.com
TOSHI_SMTP_PORT=587
TOSHI_SMTP_USER=
TOSHI_SMTP_PASSWORD=
# 通知を受け取るメールアドレス (空なら TOSHI_SMTP_USER と同じ)
TOSHI_MAIL_TO=
# LINE: LINE公式アカウントの Messaging API (チャネルアクセストークンと、自分のユーザーID)
TOSHI_LINE_TOKEN=
TOSHI_LINE_USER_ID=

# --- Claude (日足シグナルでは使いません。旧デイトレモード用) ---
# https://console.anthropic.com で取得した API キー
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (推奨・標準) / claude-opus-5-5 (高性能・約2倍の料金) / claude-haiku-4-5 (安価)
TOSHI_MODEL=claude-sonnet-5-5

# --- 株価データ: yfinance(Yahoo・無料・登録不要・約20分遅れ) / synthetic(動作確認用ダミー) ---
TOSHI_DATA=yfinance
# 監視する銘柄 (東証の4桁コード)。売買が活発な大型株を推奨
# 1単元(100株)が「資金×1銘柄の上限」を超える銘柄は自動で対象外になります
TOSHI_UNIVERSE=8306,8411,8316,8604,8601,9432,9434,4755,4689,7201,7267,6752,5020,9501,6178,7203,8058,5401,7011,6501,6758
# 成績を比べる相手 (1306 = TOPIX連動ETF)
TOSHI_BENCHMARK=1306

# --- 仮想資金とリスク ---
TOSHI_INITIAL_CASH=500000
TOSHI_LOT_SIZE=100
TOSHI_MAX_POSITIONS=2
TOSHI_MAX_POSITION_PCT=0.50
TOSHI_CASH_RESERVE_PCT=0.05
TOSHI_STOP_LOSS_PCT=0.015
TOSHI_TRAILING_STOP_PCT=0.015
TOSHI_TAKE_PROFIT_PCT=0.03
TOSHI_DAILY_LOSS_LIMIT_PCT=0.02
TOSHI_MAX_ORDERS_PER_DAY=20
TOSHI_COOLDOWN_MIN=30
TOSHI_MAX_ROUNDTRIPS=2
TOSHI_MAX_DATA_DELAY_MIN=45

# --- 時間割 (日本時間) ---
TOSHI_ENTRY_START=09:30
TOSHI_ENTRY_END=14:30
TOSHI_FLATTEN_AT=15:15
TOSHI_REVIEW_AT=15:40
# この営業日数たまったら Claude が総合評価を書く
TOSHI_EVAL_DAYS=20
TOSHI_INTERVAL_MIN=15
TOSHI_AUTO_START=yes

# --- ダッシュボード ---
TOSHI_HOST=127.0.0.1
TOSHI_PORT=8000
# 自分のPC以外から見る場合は必ず設定 (パスワードの役割)
TOSHI_DASH_TOKEN=

# --- 保存先 ---
TOSHI_DB=data/toshi.db
TOSHI_REPORT_DIR=data/reports
