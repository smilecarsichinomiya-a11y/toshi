# --- Claude ---
ANTHROPIC_API_KEY=
TOSHI_MODEL=claude-sonnet-5-5

# --- 実行モード: paper(仮想売買・既定) / live(楽天証券で実売買) ---
TOSHI_MODE=paper
# live のときは下記も "yes" が必要 (誤発注防止)
TOSHI_LIVE_CONFIRM=no

# --- データ: yfinance / synthetic(オフライン検証用ダミー) ---
TOSHI_DATA=yfinance
# 監視銘柄(東証コード, 流動性の高い銘柄を推奨)
TOSHI_UNIVERSE=7203,6758,9984,8306,8316,8411,9432,7011,7012,5401,6501,8035
# 日次成績の比較対象 (TOPIX連動ETF)
TOSHI_BENCHMARK=1306

# --- 資金・リスク (デイトレ向け) ---
TOSHI_INITIAL_CASH=3000000
TOSHI_LOT_SIZE=100
TOSHI_MAX_POSITIONS=3
TOSHI_MAX_POSITION_PCT=0.33
TOSHI_CASH_RESERVE_PCT=0.05
TOSHI_STOP_LOSS_PCT=0.01
TOSHI_TRAILING_STOP_PCT=0.01
TOSHI_TAKE_PROFIT_PCT=0.02
TOSHI_DAILY_LOSS_LIMIT_PCT=0.02
TOSHI_MAX_ORDERS_PER_DAY=40
TOSHI_COOLDOWN_MIN=15
TOSHI_MAX_ROUNDTRIPS=3

# --- 時間割 (JST) ---
TOSHI_ENTRY_START=09:05
TOSHI_ENTRY_END=14:45
TOSHI_FLATTEN_AT=15:15
TOSHI_REVIEW_AT=15:40
TOSHI_INTERVAL_MIN=5
TOSHI_AUTO_START=yes

# --- ダッシュボード ---
TOSHI_HOST=127.0.0.1
TOSHI_PORT=8000
# 設定すると API/操作に Bearer トークン必須 (外部公開する場合は必ず設定)
TOSHI_DASH_TOKEN=

# --- 保存先 ---
TOSHI_DB=data/toshi.db
TOSHI_REPORT_DIR=data/reports
# --- 楽天証券 マーケットスピードII RSS ブリッジ (live時。Excel側 BRIDGE_DIR と同じ場所) ---
TOSHI_BRIDGE_DIR=data/bridge
